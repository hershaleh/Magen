    <string name="guide_open">מדריך למצב חזק</string>
    <string name="guide_title">הגדרת מצב חזק</string>
    <string name="guide_intro">במצב חזק מגן הופכת למנהלת המכשיר (Device Owner), ולכן אנדרואיד עצמו אוכף את החוקים. ההגדרה נעשית פעם אחת ממחשב ולוקחת כחמש דקות.</string>
    <string name="g1_t">הפעלת ניפוי באגים ב-USB</string>
    <string name="g1_b">בטלפון: הגדרות, מידע על הטלפון, ולחצו 7 פעמים על \"מספר Build\". אחר כך הגדרות, מערכת, אפשרויות למפתחים, והפעילו ניפוי באגים ב-USB.</string>
    <string name="g2_t">הסרת חשבונות באופן זמני</string>
    <string name="g2_b">אנדרואיד מאפשרת זאת רק כשאין חשבון מחובר. היכנסו להגדרות, סיסמאות וחשבונות, והסירו כל חשבון, כולל חשבון Google. בסוף אפשר להוסיף אותם בחזרה. כדאי להסיר גם משתמש נוסף או פרופיל עבודה.</string>
    <string name="g3_t">התקנת adb במחשב</string>
    <string name="g3_b">הורידו את Android platform-tools מהכתובת developer.android.com/tools/releases/platform-tools, חלצו את הקובץ ופתחו חלון טרמינל בתיקייה שלו. חברו את הטלפון בכבל USB ואשרו את ההודעה שמופיעה בטלפון.</string>
    <string name="g4_t">בדיקת החיבור</string>
    <string name="g4_b">הריצו: adb devices. הטלפון אמור להופיע עם הסטטוס device, ולא unauthorized.</string>
    <string name="g5_t">הרצת הפקודה</string>
    <string name="g5_b">הריצו את הפקודה שלמטה. התשובה אמורה להתחיל במילה Success.</string>
    <string name="g6_t">סיום</string>
    <string name="g6_b">פתחו את מגן. מצב חזק אמור להופיע כפעיל. הוסיפו בחזרה את החשבונות. כדי להסיר את מגן בהמשך, השתמשו ב\"אישור הסרה\" בלשונית עוד.</string>
    <string name="guide_trouble_title">אם משהו נכשל</string>
    <string name="guide_trouble_body">יש חשבונות: הסירו כל חשבון ונסו שוב.\nיש כמה משתמשים: מחקו את המשתמשים הנוספים.\nXiaomi או Redmi: הפעילו גם \"ניפוי באגים ב-USB (הגדרות אבטחה)\" באפשרויות למפתחים.\nunauthorized: נתקו את הכבל, חברו שוב ואשרו את ההודעה בטלפון.</string>
    <string name="guide_warn">זכרו את הקוד הראשי. בלעדיו אפשר להסיר את מגן רק באיפוס להגדרות היצרן.</string>

